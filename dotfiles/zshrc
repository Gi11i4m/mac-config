export EDITOR="idea --wait"
export TMPDIR=/tmp
export PATH="$HOME/.local/bin:$PATH"
typeset -U path  # drop duplicate PATH entries (tmux starts login shells, so .zprofile runs again)
: ${HOMEBREW_PREFIX:=/opt/homebrew}  # unset in non-login shells (e.g. Omnigent), where .zprofile doesn't run

# History
HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# Options
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT INTERACTIVE_COMMENTS

# Completion
fpath=("$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# Scaleway CLI autocomplete initialization.
command -v scw >/dev/null && eval "$(scw autocomplete script shell=zsh)"

# Tools
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
source <(fzf --zsh)          # Ctrl-R history, Ctrl-T files, Alt-C cd
eval "$(zoxide init zsh)"    # z <partial-dir>, zi for interactive
# Omnigent's terminal draws emoji over the space after them; pad them there.
if [[ -n $OMNIGENT ]]; then
  mkdir -p ~/.cache
  sed -E 's/(☕|🦕|🥟|🐍) /\1  /' ~/.config/starship.toml > ~/.cache/starship-omnigent.toml
  export STARSHIP_CONFIG=~/.cache/starship-omnigent.toml
fi
eval "$(starship init zsh)"
# Each segment ends in an arrow on the terminal background, because Starship can't know which
# optional segment comes next. Give each arrow the background of the segment that follows it.
_starship_join_arrows() {
  perl -pe 's/\e\[38;5;(\d+)m(%\})\xee\x82\xb0((?:%\{\e\[0m%\})?%\{\e\[(?:\d+;)*?48;5;(\d+))/\e[38;5;$1;48;5;$4m$2\xee\x82\xb0$3/g'
}
PROMPT="${PROMPT%)} | _starship_join_arrows)"

# Slightly lighter background than the terminal default
if [[ -n $TMUX ]]; then
  tmux select-pane -P 'bg=#282c34'
else
  printf '\e]11;#282c34\a'
fi

alias ls='eza --group-directories-first'
alias ll='eza -l --git --group-directories-first'
alias la='eza -la --git --group-directories-first'
alias lt='eza --tree --level=2 --git-ignore'

# Workaround for anthropics/claude-code#96482 (messages wrapped as <pasted_content>)
alias claude='DISABLE_GROWTHBOOK=1 claude'

# Machine-specific settings, not kept in this repo
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Plugins (syntax highlighting must be last)
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
# Cyan instead of green for valid commands
for style in arg0 command builtin alias suffix-alias global-alias function hashed-command autodirectory; do
  ZSH_HIGHLIGHT_STYLES[$style]='fg=cyan'
done
ZSH_HIGHLIGHT_STYLES[precommand]='fg=cyan,underline'
